{
  "entities": {
    "Lead": {
      "title": "Lead",
      "description": "General consultation or contact lead",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email", "phone", "createdAt"]
    },
    "Subscriber": {
      "title": "Newsletter Subscriber",
      "description": "Newsletter subscribers",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "createdAt"]
    },
    "CourseSignup": {
      "title": "Course Signup",
      "description": "Courses registration and signup details",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "courseType": { "type": "string", "enum": ["physical", "digital"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email", "phone", "courseType", "createdAt"]
    },
    "Article": {
      "title": "Article",
      "description": "A media article, columns, and podcasts",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "category": { "type": "string", "enum": ["טור שבועי", "כתבות ומאמרים", "פודקאסטים", "קווי מידע"] },
        "categoryId": { "type": "string", "enum": ["weekly", "articles", "podcast", "kavei"] },
        "date": { "type": "string" },
        "image": { "type": "string" },
        "content": { "type": "string" },
        "link": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "category", "categoryId", "date", "image", "content"]
    }
  },
  "firestore": {
    "/leads/{leadId}": {
      "schema": "Lead",
      "description": "Consultation and contact leads"
    },
    "/subscribers/{subscriberId}": {
      "schema": "Subscriber",
      "description": "Newsletter subscriptions"
    },
    "/course_signups/{signupId}": {
      "schema": "CourseSignup",
      "description": "Signups for real estate courses"
    },
    "/articles/{articleId}": {
      "schema": "Article",
      "description": "Media library articles and columns"
    }
  }
}
